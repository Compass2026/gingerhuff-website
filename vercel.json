{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "functions": {
    "api/contact.ts": {
      "maxDuration": 60
    },
    "api/inquiry-retry.ts": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/contact-2/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/category/:category/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/sitemaps.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/inquiry-retry/",
      "schedule": "*/5 * * * *"
    }
  ]
}
